# Isolated config for the all-languages build — sourced by launch scripts only.
# NEVER loaded by the MCP server: MONGO_DB here points at the build DB, while
# the live server keeps serving barygraph_poc via the main .env.
KAIKKI_PATH=data/kaikki.org-dictionary-all.jsonl
KAIKKI_LANGS=*
PARSED_DIR=data/parsed_all
PIPELINE_STATE_DIR=pipeline_state_all
MONGO_DB=barygraph_all
MONGO_COLLECTION=barygraph
MONGO_URI=mongodb://mongodb:27017/?directConnection=true
OLLAMA_URL=http://ollama:11434
EMBED_MODEL=qwen3-embedding:8b
EMBED_DIM=4096
EMBED_BATCH_SIZE=128
EMBED_TIMEOUT_SECONDS=900
# Larger Mongo bulk-write batches amortize per-batch fixed overhead (~1.5-2x
# write throughput vs 512 on this build).
BATCH_SIZE=2048
# Dedupes repeated embed texts (~21% of senses; kaikki repeats entries across
# etymology splits). Sidecar is append-only JSONL; safe to delete anytime.
# Cache lives on /storage (reentry key-type cache; ~4.3M of the 5.64M Phase-A
# keys already cached there as of the Sep-12/13 runs). The old main-pairing
# cache (data/parsed_all/embed_cache.jsonl, ~460G on /workspace) is archived
# and no longer used by the remaining reentry stages.
EMBED_CACHE_FILE=/storage/bary/s04_reentry_cache.jsonl
LOG_LEVEL=INFO
