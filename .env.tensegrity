# BaryGraph Tensegrity pipeline — document ingestion (sentences L15 / titles L14).
#
# Isolated from the Kaikki PoC: separate Mongo DB *and* collection (both
# "tensegrity"), separate parsed/state dirs. The MCP server never sources this
# file; it always runs on the PoC config in `.env`.
#
# Use it with:  python -m tensegrity_pipeline <stage> --env tensegrity

MONGO_URI=mongodb://localhost:27117/?directConnection=true
MONGO_DB=tensegrity
MONGO_COLLECTION=tensegrity
# Integration tests only ever touch DBs carrying this prefix (safety guard).
MONGO_TEST_DB_PREFIX=barygraph_test_

OLLAMA_URL=http://localhost:11435
# Step I embeddings: qwen0.6, 1024-d.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024

PARSED_DIR=data/parsed_tensegrity
PIPELINE_STATE_DIR=pipeline_state_tensegrity

BATCH_SIZE=512
EMBED_BATCH_SIZE=64

# --- Pairing / hierarchy thresholds ---
Q_MIN_L15=0.72
META_BARY_COS_THRESHOLD=0.90
LEVEL_FACTOR_ALPHA=0.5

# --- tev1 decision model (complement vs contradict role) ---
# Served by the same ollama host as the embedder, on the Jev TypeSafe endpoint
# POST /v1/systemone (see cognitive/not_sure.py).
TEV1_URL=http://localhost:11435
TEV1_MODEL=tev1:0.8b
TEV1_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO

# Set to 1 to replace ollama/tev1 with deterministic fakes (CI / offline dev).
BARY_FAKE_EMBED=0
BARY_FAKE_DECISION=0
