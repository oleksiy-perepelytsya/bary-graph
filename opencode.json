{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "apiKey": "ollama",
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000
      },
      "models": {
        "qwen3-embedding:8b": {
          "name": "Qwen3 8B Embedding (in-container)",
          "tool_call": false,
          "cost": { "input": 0, "output": 0 }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://ollama:11434/v1",
        "apiKey": "ollama",
        "headerTimeout": 1800000,
        "chunkTimeout": 1800000
      },
      "models": {
        "qwen3.6:27b-q4_K_M-ctx64k": {
          "name": "Qwen3.6 27B Q4 64K ctx (GPU, RTX 3090)",
          "tool_call": true,
          "reasoning": true,
          "temperature": false,
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  },
  "mcp": {
    "barygraph": {
      "type": "remote",
      "url": "https://mild-infrastructure-should-batch.trycloudflare.com/mcp",
      "enabled": true
    },
    "cog": {
      "type": "local",
      "command": ["python3.11", "-m", "scripts.mcp_int_cog"],
      "enabled": true,
      "environment": {
        "MCP_MONGO_DB": "barygraph_poc",
        "COGNITIVE_BATCH_DIR": "/workspace/bary-vector/cognitive/batches"
      }
    }
  }
}
